generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String   @id @default(uuid())
  name            String
  sku             String   
  price           Float    // Selling price (Ex-Tax)
  lastCostPrice   Float    @default(0) // Updated after every purchase
  lastPurchasedAt DateTime?
  taxRate         Float    @default(0) // Percentage (e.g. 15.0)
  stock           Int
  leadTime        Int
  bufferStock     Int      @default(0)

  // 🔗 Relationships
  preferredSupplierId String?
  preferredSupplier   Supplier? @relation(fields: [preferredSupplierId], references: [id])
  
  movements       StockMovement[]
  orderItems      OrderItem[]       
  purchaseItems   PurchaseItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
}

model Supplier {
  id             String    @id @default(uuid())
  name           String
  gstNumber      String?
  contactPerson  String?
  email          String?
  phone          String?
  paymentTerms   String?   // e.g. "Net 30", "Cash on Delivery"
  isActive       Boolean   @default(true)
  
  products       Product[]
  purchases      Purchase[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Purchase {
  id           String         @id @default(uuid())
  supplierId   String
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  
  totalAmount  Float
  status       PurchaseStatus @default(COMPLETED)
  referenceNo  String?        // Invoice or PO number
  
  items        PurchaseItem[]
  movements    StockMovement[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model PurchaseItem {
  id           String   @id @default(uuid())
  purchaseId   String
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  
  quantity     Int
  costPrice    Float    // Captured at time of purchase
  
  createdAt    DateTime @default(now())
}

model StockMovement {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  
  purchaseId   String?
  purchase     Purchase? @relation(fields: [purchaseId], references: [id])

  type         MovementType
  quantity     Int
  createdAt    DateTime @default(now())
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum MovementType {
  SALE
  PURCHASE
  ADJUSTMENT
  RETURN
}

model DailySales {
  id        String   @id @default(uuid())
  date      DateTime @unique
  revenue   Float    @default(0)
  unitsSold Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductStats {
  id             String   @id @default(uuid())
  productId      String   @unique
  totalSold      Int      @default(0)
  totalPurchased Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


// --- NEW MODELS FOR FORECASTING ---

model Order {
  id          String      @id @default(uuid())
  total       Float       // Total money collected for this order
  status      String      @default("COMPLETED") // E.g., COMPLETED, REFUNDED
  
  items       OrderItem[] // Links an order to its individual items
  
  idempotencyKey String?  @unique // Prevents double checkout

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id          String      @id @default(uuid())
  
  // 🔗 Link back to the parent Order
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // 🔗 Link to the Product that was sold
  productId   String
  product     Product     @relation(fields: [productId], references: [id])
  
  quantity    Int
  price       Float       // Price AT THE TIME OF SALE (in case product price changes later)
  
  createdAt   DateTime    @default(now())
}
