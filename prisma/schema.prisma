generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  sku         String   
  price       Float
  stock       Int
  leadTime    Int
  bufferStock Int      @default(0)

  movements   StockMovement[]
  orderItems  OrderItem[]       

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}


model StockMovement {
  id        String   @id @default(uuid())

  // 🔗 Foreign key
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  //  Movement type
  type      MovementType

  //  Always positive number
  quantity  Int

  createdAt DateTime @default(now())
}

//  ENUM (must be outside models)
enum MovementType {
  SALE
  PURCHASE
  ADJUSTMENT
}

model DailySales {
  id        String   @id @default(uuid())
  date      DateTime @unique
  revenue   Float    @default(0)
  unitsSold Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductStats {
  id             String   @id @default(uuid())
  productId      String   @unique
  totalSold      Int      @default(0)
  totalPurchased Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


// --- NEW MODELS FOR FORECASTING ---

model Order {
  id          String      @id @default(uuid())
  total       Float       // Total money collected for this order
  status      String      @default("COMPLETED") // E.g., COMPLETED, REFUNDED
  
  items       OrderItem[] // Links an order to its individual items
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id          String      @id @default(uuid())
  
  // 🔗 Link back to the parent Order
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // 🔗 Link to the Product that was sold
  productId   String
  product     Product     @relation(fields: [productId], references: [id])
  
  quantity    Int
  price       Float       // Price AT THE TIME OF SALE (in case product price changes later)
  
  createdAt   DateTime    @default(now())
}
